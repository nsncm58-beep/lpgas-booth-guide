rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function myEvent() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.eventCode; }
    function isMaster() { return request.auth != null && request.auth.uid in ['mJS0Sg6dWQYBmARvtfeytacBSUN2']; }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    match /schedules/{docId} {
      allow read: if request.auth != null && (resource.data.eventCode == myEvent() || isMaster());
      allow create, update: if request.auth != null && (docId == request.auth.uid || docId.matches('^' + request.auth.uid + '__.*')) && (request.resource.data.eventCode == myEvent() || isMaster());
      allow delete: if request.auth != null && (docId == request.auth.uid || docId.matches('^' + request.auth.uid + '__.*'));
    }

    match /{document=**} { allow read, write: if false; }
  }
}
