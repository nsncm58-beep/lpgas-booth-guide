rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function myEvent() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.eventCode; }
    function isMaster() { return request.auth != null && request.auth.uid in ['mJS0Sg6dWQYBmARvtfeytacBSUN2', 'roafgq9A27Rrg1DewdCvy2TnxDk1']; }
    function isHome() { return request.auth != null && request.auth.uid in ['OjQ9GnNOF0dm10hkdAZlYyTcCHJ2']; }
    function ownDoc(docId) { return docId == request.auth.uid || docId.matches('^' + request.auth.uid + '__.*'); }
    // The app is locked to exactly these events. Because a profile's eventCode
    // must be on this list, myEvent() is always valid too, and everything that
    // validates against myEvent() (schedules, notes) inherits the lock.
    // Reps pick a BRAND at signup and the app assigns that brand's current
    // show, so these codes are never typed by anyone — but they still gate
    // what can be written. Rolling a brand to a new show = add its code here
    // AND to CURRENT_SHOW/EVENTS/MEDIA in index.html, then republish these
    // rules (a rep's automatic rollover writes the new code to their profile,
    // and that write fails until the code is listed here).
    function validEvent(c) { return c in ['LPGAS-2026', 'GOLFDOM-2026', 'LM-2026', 'PMP-2026', 'PQ-2026']; }

    // Profiles hold names + emails, so reads are limited to yourself, masters
    // and the home account (teammates see names via schedules/notes instead).
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isMaster() || isHome());
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && validEvent(request.resource.data.eventCode)
                            && (!("dept" in request.resource.data) || request.resource.data.dept in ["sales", "edit"]);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // isHome(): the home dashboard's Schedules view shows rep agendas read-only.
    match /schedules/{docId} {
      // Home may only read Editorial/Digital schedules (matches the client's
      // dept-filtered query); the field team bar reads same-event as before.
      allow read: if request.auth != null && (resource.data.eventCode == myEvent() || isMaster()
                                              || (isHome() && resource.data.dept == "edit"));
      allow create, update: if request.auth != null && ownDoc(docId) && (request.resource.data.eventCode == myEvent() || isMaster());
      allow delete: if request.auth != null && (ownDoc(docId) || isMaster());
    }

    match /notes/{docId} {
      // Home may only read Editorial/Digital notes; sales/legacy docs (no
      // dept field, e.g. Brian's) are unreadable by home and never displayed.
      allow read: if request.auth != null && (ownDoc(docId) || isMaster()
                                              || (isHome() && resource.data.dept == "edit"));
      allow create, update: if request.auth != null && ownDoc(docId) && (request.resource.data.eventCode == myEvent() || isMaster());
      allow delete: if request.auth != null && (ownDoc(docId) || isMaster());
    }

    // (The old `uploads` block from the removed Dropbox-OAuth feature is
    // gone: that collection is unused, and dropping the rules means the
    // default deny-all below closes it completely.)

    // Teams notification setup: the Power Automate flow URL (it carries a
    // sig= secret, so it must never sit in the public repo) plus the home
    // desk's name->email map. Every signed-in user READS it, because a rep's
    // own device is what fires the "video ready to produce" DM. Only masters
    // write it, via Settings > Admin > Teams notifications.
    match /config/{docId} {
      // config/admin holds the bullpen passcode for the Admin sheet: masters
      // only. (Overlapping matches OR together, so the exclusion lives here.)
      allow read: if request.auth != null && docId != "admin";
      allow create, update, delete: if isMaster();
    }
    match /config/admin {
      allow read: if isMaster();
    }

    // Home-team workflow flags ("Follow up" / "Covered" on shared booth notes).
    // Written by the shared home account so all four members see the same
    // state across devices; masters can read and clean up.
    match /homeFlags/{docId} {
      allow read, create, update, delete: if request.auth != null && (isHome() || isMaster());
    }

    // Video pipeline: home marks a rep's visited booth's video as done;
    // the rep reads their own records to show the "Video done" chip.
    match /videoStatus/{docId} {
      allow read: if request.auth != null && (resource.data.repUid == request.auth.uid || isHome() || isMaster());
      allow create, update, delete: if request.auth != null && (isHome() || isMaster());
    }

    // Archived past-show CSVs. Each doc is owned by the rep who archived it
    // (readable by them or a master); created by the owner; deletable by owner/master.
    match /archives/{docId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isMaster());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isMaster());
    }

    match /{document=**} { allow read, write: if false; }
  }
}
